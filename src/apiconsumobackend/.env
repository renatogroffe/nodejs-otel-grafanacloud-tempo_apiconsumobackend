PORT=8070
URL_API_TESTES=http://localhost:5101/contador/postgres
URL_API_TESTES2=http://localhost:5101/contador/mysql
OTEL_TRACES_EXPORTER=otlp
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_COMPRESSION=gzip
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://otlp-gateway-prod-sa-east-1.grafana.net/otlp/v1/traces
# Grafana Cloud: gere um token de instancia com permissao de escrita em traces.
# TOKEN_AUTH deve ser Base64("<instance-id>:<api-token>").
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic TOKEN_AUTH
OTEL_NODE_RESOURCE_DETECTORS=env,host,os,serviceinstance
OTEL_SERVICE_NAME=apiconsumobackend